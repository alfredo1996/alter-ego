{
  "name": "@alter-ego/web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "NEXT_PUBLIC_BACKEND=firebase NEXT_PUBLIC_USE_EMULATOR=true NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-alter-ego.firebaseapp.com NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-alter-ego NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000 NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000 next dev --port 3003",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:firebase": "vitest run --config vitest.emulator.ts",
    "test:firebase:alt": "FIRESTORE_EMULATOR_HOST=127.0.0.1:18080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099 vitest run --config vitest.emulator.ts",
    "test:e2e": "playwright test",
    "shots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/shots.mjs",
    "local:rules": "tsx scripts/local-rules.ts",
    "seed:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-demo.mjs",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-firebase-categories.ts",
    "seed:firebase": "tsx scripts/seed-firebase-categories.ts"
  },
  "dependencies": {
    "@alter-ego/kernel": "workspace:*",
    "@alter-ego/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/mdx": "^2.0.13",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "firebase-admin": "13.6.1",
    "fumadocs-core": "^16.6.9",
    "fumadocs-mdx": "^14.2.9",
    "fumadocs-ui": "^16.6.9",
    "lucide-react": "^0.575.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "swagger-ui-react": "^5.34.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^20.7.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
