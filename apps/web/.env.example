# Alter Ego — environment
#
# Copy to .env.local and fill in. Everything here is read by src/lib/env.ts
# (client-side, NEXT_PUBLIC_*) or by the server-side Firebase Admin client.
# The defaults below run the app with the in-memory mock backend, no accounts
# and no cloud project needed.

# ─── Backend ──────────────────────────────────────────────────────────────────
# mock     = in-memory, seeded on boot, wiped on restart. No setup. Good for dev.
# firebase = Firestore + Firebase Auth. Needs the NEXT_PUBLIC_FIREBASE_* block.
NEXT_PUBLIC_BACKEND=mock

# ─── Firebase (only when NEXT_PUBLIC_BACKEND=firebase) ────────────────────────
# From the Firebase console: Project settings → General → Your apps → SDK setup.
# These are public by design — access is controlled by firestore.rules, not by
# hiding them. Never put a service-account key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Local emulator ───────────────────────────────────────────────────────────
# Points the SDK at the Firebase emulator instead of a real project.
# `pnpm test:firebase:docker` sets the host variables itself; set this one only
# when running the app (not the tests) against the emulator.
NEXT_PUBLIC_USE_EMULATOR=false
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ─── Server-side credentials (never NEXT_PUBLIC_, never committed) ────────────
# The Admin SDK bypasses firestore.rules, so this is a full-access key. It is
# needed only for the REST API and the MCP server. On Google infrastructure,
# leave both unset and the runtime service account is used automatically.
#
# Provide ONE of:
#   FIREBASE_SERVICE_ACCOUNT_JSON = the key file's contents, inline (one line)
#   GOOGLE_APPLICATION_CREDENTIALS = path to the key file on disk
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_PROJECT_ID=your-project

# ─── MCP server ───────────────────────────────────────────────────────────────
# Public origin the MCP server advertises in its OAuth metadata. Set this when
# the app is behind a proxy or tunnel that rewrites the request origin.
# MCP_PUBLIC_ORIGIN=https://your-deployment.example.com
